plot_index_map <- function(shapefile_path,
                           index_column,
                           title = "Index Value Map",
                           subtitle = NULL,
                           legend_title = "Index",
                           palette = "viridis",
                           direction = 1,
                           border_color = "grey30",
                           border_size = 0.2,
                           na_color = "grey80",
                           caption = NULL) {

  #Read the shapefile
  if (!file.exists(shapefile_path)) {
    stop("Shapefile not found at: ", shapefile_path)
  }

  map_data <- sf::st_read(shapefile_path, quiet = TRUE)

  # Validate the index column 
  if (!index_column %in% names(map_data)) {
    stop("Column '", index_column,
         "' not found. Available columns: ",
         paste(names(map_data), collapse = ", "))
  }

  #Ensure geometry is valid
  map_data <- sf::st_make_valid(map_data)

  #Build the map 
  p <- ggplot(data = map_data) +
    geom_sf(aes(fill = .data[[index_column]]),
            color = border_color,
            size  = border_size) +
    scale_fill_viridis_c(
      option   = palette,
      direction = direction,
      name     = legend_title,
      na.value = na_color,
      labels   = scales::comma
    ) +
    #Map elements 
    annotation_scale(
      location   = "bl",          # bottom-left
      width_hint = 0.3,
      style      = "bar"
    ) +
    annotation_north_arrow(
      location = "tr",            # top-right
      which_north = "true",
      style = north_arrow_fancy_orienteering(),
      height = unit(1.2, "cm"),
      width  = unit(1.2, "cm")
    ) +
    # Labels
    labs(
      title    = title,
      subtitle = subtitle,
      caption  = caption,
      x        = "Longitude",
      y        = "Latitude"
    ) +
    #Theme
    theme_minimal(base_size = 12) +
    theme(
      plot.title      = element_text(face = "bold", size = 16, hjust = 0.5),
      plot.subtitle   = element_text(size = 12, hjust = 0.5),
      plot.caption    = element_text(size = 8, face = "italic"),
      legend.position = "right",
      legend.key.height = unit(1.2, "cm"),
      panel.grid      = element_line(color = "grey90", size = 0.2),
      axis.text       = element_text(size = 8)
    )

  return(p)
}

