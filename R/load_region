# This function loads ADM0, ADM1, and ADM2 boundaries for Germany from
# Google Earth Engine and returns them as Earth EngineeFeatureCollections.

# @params: country_name | Character string - Country to analyze (Default= Germany)
# @ return: A list containing-
#   - country_geometry : EE Geometry
#   - adm1             : EE FeatureCollection
#   - adm2             : EE FeatureCollection

# @example: germany_regions <- load_germany_regions()

load_region <- function(country_name= "Germany"){
    # Ensure country_name is character
    if (!is.character(country_name)) {
        stop("'country_name' must be a character string.")
    }

    # Ensure single value supplied
    if (length(country_name) != 1) {
        stop("'country_name' must contain exactly one value.")
    }

    # Ensure non-empty string
    if (nchar(country_name) == 0) {
        stop("'country_name' cannot be empty.")
    }

    # Load the Administrative Datasets
    admin0 <- ee$FeatureCollection(
        "projects/sat-io/open-datasets/geoboundaries/CGAZ_ADM0"
    )

    adm1_collection <- ee$FeatureCollection(
        "projects/earthengine-legacy/assets/projects/sat-io/open-datasets/geoboundaries/HPSCGS-ADM1"
    )

    adm2_collection <- ee$FeatureCollection(
        "projects/earthengine-legacy/assets/projects/sat-io/open-datasets/geoboundaries/HPSCGS-ADM2"
    )

    # Filter to Germany
    country_feature <- admin0$
        filter(ee$Filter$eq("shapeName", country_name))

    country_geometry <- country_feature$geometry()

    adm1_regions <- adm1_collection$
        filterBounds(country_geometry)

    adm2_regions <- adm2_collection$
        filterBounds(country_geometry)


    # Return the list of EngineFeatureCollections
    return(list(
        country_geometry = country_geometry,
        adm1 = adm1_regions,
        adm2 = adm2_regions
    ))
}