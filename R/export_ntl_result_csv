# This function converts an Earth Engine FeatureCollection into an sf object
# and exports it as a CSV file into a designated folder within the current project directory.

# @param: ee_featurecollection | Earth Engine FeatureCollection.
# @param: output_folder | Character string- Folder name inside project directory.
# @param: output_filename | Character string- Name of CSV file.
#
# @return: Character string containing exported file path.

export_ntl_results_csv <- function(
    ee_featurecollection,
    output_folder = "outputs",
    output_filename = "germany_ntl_stats.csv"
){
    if (missing(ee_featurecollection)) {
        stop("'ee_featurecollection' is required.")
    }
    if (!is.character(output_folder)) {
        stop("'output_folder' must be a character string.")
    }
    if (!is.character(output_filename)) {
        stop("'output_filename' must be a character string.")
    }
    if (length(output_folder) != 1 ||
        length(output_filename) != 1) {
        stop("Arguments must contain single values only.")
    }

    # Create folder if it does not already exist
    if (!dir.exists(output_folder)) {
        dir.create(
            output_folder,
            recursive= TRUE
        )
    }

    # Convert EE object into sf dataframe
    sf_data <- ee_as_sf(ee_featurecollection)

    # Remove geometry column before CSV export
    attribute_data <- st_drop_geometry(sf_data)

    # Define Output File Path
    output_path <- file.path(
        output_folder,
        output_filename
    )

    # Export CSV File
    write.csv(
        attribute_data,
        output_path,
        row.names = FALSE 
    )

    # Return output file location
    message("CSV successfully exported to:")
    message(normalizePath(output_path))

    return(normalizePath(output_path))
}