# This function calculates monthly nighttime light statistics and 
# population totals for German ADM2 regions.

# @param: regions_list | List returned from load_germany_regions().
# @param: start_date | Character string in YYYY-MM-DD format.
# @param: interval_count | Integer- Number of intervals to process.
# @param: scale_ntl | Numeric- Spatial resolution for NTL analysis.
# @param: scale_pop | Numeric- Spatial resolution for population analysis.

# @return EE FeatureCollection with:
#   - Monthly NTL sum statistics for each ADM2 region
#   - Monthly NTL mean statistics for each ADM2 region
#   - Population totals for each ADM2 region

# @example:
#   germany_regions <- load_germany_regions()
#   results <- compute_germany_ntl_stats(germany_regions)

compute_ntl_stats <- function(
    regions_list,
    start_date= "2025-01-01",
    interval_count= 12,
    scale_ntl= 5000,
    scale_pop= 10
){
    # Ensure regions_list is a list
    if (!is.list(regions_list)) {
        stop("'regions_list' must be a list.")
    }

    # Ensure required elements exist
    required_names <- c("country_geometry", "adm1", "adm2")
    missing_names <- setdiff(required_names, names(regions_list))

    if (length(missing_names) > 0) {
        stop(
            "Missing required elements in 'regions_list': ",
            paste(missing_names, collapse= ", ")
        )
    }

    # Ensure start_date is character
    if (!is.character(start_date) || length(start_date) != 1) {
        stop("'start_date' must be a single character string.")
    }

    # Ensure interval_count is positive integer
    if (!is.numeric(interval_count) || interval_count <= 0) {
        stop("'interval_count' must be a positive numeric value.")
    }

    # Ensure scale values are positive
    if (scale_ntl <= 0 || scale_pop <= 0) {
        stop("'scale_ntl' and 'scale_pop' must be positive.")
    }

    # Define the Analysis Region
    regions <- regions_list$adm2  # using the ADM2 for zonal statistics

    # Load the Nighttime Light Data
    dataset <- ee$
       ImageCollection("NOAA/VIIRS/001/VNP46A2")$
       select("DNB_BRDF_Corrected_NTL")

    # Define Reducers
    # compute sum and mean for each polygon
    spatial_reducers <- ee$Reducer$sum()$combine(
        reducer2= ee$Reducer$mean(),
        sharedInputs= TRUE
    )

    # Aggregates imagery over time
    temporal_reducer <- ee$Reducer$sum()

    # Initialize FeatureCollection
    zonal_stats <- regions

    # Loop through the months
    for (i in 0:(interval_count - 1)) {
        # Define temporal window
        start_range <- ee$Date(start_date)$advance(i, "month")
        end_range <- start_range$advance(1, "month")
        # Aggregate imagery within time interval
        temporal_stat <- dataset$
            filterDate(start_range, end_range)$
            reduce(temporal_reducer)

        # The function below computes the zonal stats for each feature
        reduce_function <- function(feature) {
            # Compute statistics inside polygon
            stats <- temporal_stat$reduceRegion(
                reducer = spatial_reducers,
                geometry = feature$geometry(),
                scale = scale_ntl,
                crs = dataset$first()$projection(),
                maxPixels = 1e9
            )

            # Rename the output columns with the date suffix
            keys <- stats$keys()
            new_keys <- keys$map(
                ee_utils_pyfunc(function(k) {
                    ee$String(k)$cat("_")$
                        cat(start_range$format("YYYY-MM-dd"))
                })
            )

            # Apply renamed properties to feature
            renamed_stats <- stats$rename(keys, new_keys)
            feature$set(renamed_stats)
        }

        # Apply zonal statistics to all regions
        zonal_stats <- zonal_stats$map(
            ee_utils_pyfunc(reduce_function)
        )
    }

    # Load Population Data
    population_image <- ee$
        Image("JRC/GHSL/P2023A/GHS_POP/2030")$
        select("population_count")

    # Add Population to each Feature
    add_population <- function(feature) {
        # Compute total population within polygon
        population_stats <- population_image$reduceRegion(
            reducer = ee$Reducer$sum(),
            geometry = feature$geometry(),
            scale = scale_pop,
            maxPixels = 1e9
        )

        # Attach population value to feature
        feature$set(
            "population_total",
            population_stats$get("population_count")
        )
    }

    # Apply population extraction
    final_output <- zonal_stats$map(
        ee_utils_pyfunc(add_population)
    )

    # Return final Feature Collection
    return(final_output)
}