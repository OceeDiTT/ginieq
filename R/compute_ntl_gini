# This function takes a sf object, perform some analysis and 
# returns the Gini Index as a cleaned csv and shapefile.

# @param: germany_sf | sf object 
# @param: output_dir | Character string- Directory path to save final results.
#
# @return: 
# - CSV
# - Shapefile

compute_ntl_gini <- function(
    germany_sf,
    output_dir = "outputs"
){
    dir.create(
        output_dir,
        showWarnings = FALSE,
        recursive = TRUE
    )

    ntl_cols <- c(
        "NTL_Jan_Mean",
        "NTL_Feb_Mean",
        "NTL_Mar_Mean",
        "NTL_Apr_Mean",
        "NTL_May_Mean",
        "NTL_Jun_Mean",
        "NTL_Jul_Mean",
        "NTL_Aug_Mean",
        "NTL_Sep_Mean",
        "NTL_Oct_Mean",
        "NTL_Nov_Mean",
        "NTL_Dec_Mean"
    )

    # Log-transformed per-capita NTL
    germany_sf[ntl_cols] <- lapply(
        germany_sf[ntl_cols],
        function(x) log(x + 1)
    )

    germany_sf[ntl_cols] <- Map(
        "/",
        germany_sf[ntl_cols],
        germany_sf$pop
    )

    # Gini function
    gini <- function(x) {
        x <- as.numeric(x)
        if (mean(x, na.rm = TRUE) == 0) {
            return(NA)
        }

        total <- 0

        for (i in seq_len(length(x) - 1)) {
            total <- total +
                sum(abs(x[i] - x[(i + 1):length(x)]), na.rm= TRUE)
        }

        total / (length(x)^2 * mean(x, na.rm = TRUE))
    }

    # Calculate Gini per administrative unit
    germany_sf$Gini_Coefficient <- apply(
        germany_sf[, ntl_cols],
        1,
        gini
    ) * 100

    germany_sf$Gini_Coefficient <-
        round(germany_sf$Gini_Coefficient, 1)


    # Classification
    germany_sf$Gini_Category <- cut(
        germany_sf$Gini_Coefficient,
        breaks = c(0, 30, 45, 60, Inf),
        labels = c(
            "Low",
            "Moderate",
            "High",
            "Very High"
        ),
        include.lowest= TRUE   
    )

    # Mean Gini
    mean_gini <- mean(
        germany_sf$Gini_Coefficient,
        na.rm = TRUE
    )

    cat(
        "Mean Gini Coefficient:",
        round(mean_gini, 2),
        "%\n"
    )

    # Export CSV
    write_csv(
        st_drop_geometry(germany_sf),
        file.path(
            output_dir,
            "Germany_Gini_Results.csv"
        )
    )

    # Export Shapefile
    st_write(
        germany_sf,
        file.path(
            output_dir,
            "Germany_Gini_Results.shp"
        ),

        delete_layer= TRUE,
        quiet= TRUE
    )

    return(germany_sf)
}