Package: ginieq
Title: Spatial and Temporal Inequality in Night-Time Light Emissions across Nigerian LGAs
Version: 0.1.0
Authors@R: 
    person(
        "Christian", "Oluoma",
        email = "c.oluoma@uni-muenster.de",
        role = c("aut", "cre"),
        comment = c(ORCID = "0009-0003-8382-3263")
